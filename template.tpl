___SANDBOXED_JS_FOR_SERVER___

const claimRequest = require('claimRequest');
const getRequestPath = require('getRequestPath');
const getRequestMethod = require('getRequestMethod');
const getRequestBody = require('getRequestBody');
const sendHttpGet = require('sendHttpGet');
const runContainer = require('runContainer');
const returnResponse = require('returnResponse');
const setResponseStatus = require('setResponseStatus');
const setResponseBody = require('setResponseBody');
const logToConsole = require('logToConsole');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');
const getType = require('getType');
const JSON = require('JSON');

const API_BASE = 'https://api.hubapi.com/crm/v3/objects/contacts/';

const respond = (status, message) => {
  setResponseStatus(status);
  setResponseBody(message);
  returnResponse();
};

if (getRequestPath() !== data.path) return;

claimRequest();

if (getRequestMethod() !== 'POST') {
  respond(405, 'Method not allowed');
  return;
}

const body = getRequestBody();
const events = body ? JSON.parse(body) : undefined;

if (getType(events) !== 'array' || events.length === 0) {
  respond(400, 'Bad request');
  return;
}

// Acknowledge HubSpot quickly so the webhook is not retried.
respond(200, 'Ok');

const propertyNames = [];
if (getType(data.contactProperties) === 'array') {
  data.contactProperties.forEach((row) => {
    if (row && row.properties) propertyNames.push(encodeUriComponent(makeString(row.properties)));
  });
}
const query = propertyNames.length ? '?properties=' + propertyNames.join(',') : '';

events.forEach((evt, index) => {
  const contactId = evt ? evt.objectId : undefined;

  if (!contactId) {
    logToConsole('HubSpot Client: no objectId found at index ' + index);
    return;
  }

  const requestUrl = API_BASE + encodeUriComponent(makeString(contactId)) + query;

  sendHttpGet(requestUrl, {
    headers: { Authorization: 'Bearer ' + data.accessToken },
    timeout: 5000
  }).then((result) => {
    if (result.statusCode < 200 || result.statusCode >= 300) {
      logToConsole('HubSpot Client: API returned status ' + result.statusCode + ' for contact ' + contactId);
      return;
    }

    const contact = JSON.parse(result.body) || {};

    runContainer({
      event_name: data.eventName,
      contactId: contactId,
      lead_status: evt.propertyValue,
      properties: contact.properties || {},
      property_name: evt.propertyName,
      subscription_type: evt.subscriptionType,
      occurred_at: evt.occurredAt,
      event_id: evt.eventId
    });
  }, () => {
    logToConsole('HubSpot Client: request failed for contact ' + contactId);
  });
});



___TESTS___

scenarios:
- name: Ignores requests on a different path
  code: |-
    mock('getRequestPath', '/other');
    runCode(mockData);
    assertApi('claimRequest').wasNotCalled();
    assertApi('sendHttpGet').wasNotCalled();
- name: Rejects non-POST requests with 405
  code: |-
    mock('getRequestPath', '/hubspot');
    mock('getRequestMethod', 'GET');
    runCode(mockData);
    assertApi('setResponseStatus').wasCalledWith(405);
    assertApi('sendHttpGet').wasNotCalled();
- name: Rejects invalid JSON body with 400
  code: |-
    mock('getRequestPath', '/hubspot');
    mock('getRequestMethod', 'POST');
    mock('getRequestBody', 'not json');
    runCode(mockData);
    assertApi('setResponseStatus').wasCalledWith(400);
    assertApi('sendHttpGet').wasNotCalled();
- name: Fetches contact and runs container for a valid webhook
  code: |-
    mock('getRequestPath', '/hubspot');
    mock('getRequestMethod', 'POST');
    mock('getRequestBody', '[{"objectId":123,"propertyName":"hs_lead_status","propertyValue":"CONNECTED","subscriptionType":"contact.propertyChange","eventId":1,"occurredAt":1700000000000}]');
    let requestedUrl;
    let requestOptions;
    mock('sendHttpGet', (url, options) => {
      requestedUrl = url;
      requestOptions = options;
      return {
        then: (onSuccess, onFailure) => {
          onSuccess({ statusCode: 200, body: '{"id":"123","properties":{"email":"test@example.com"}}' });
        }
      };
    });
    let eventData;
    mock('runContainer', (evt) => {
      eventData = evt;
    });
    runCode(mockData);
    assertApi('setResponseStatus').wasCalledWith(200);
    assertThat(requestedUrl).isEqualTo('https://api.hubapi.com/crm/v3/objects/contacts/123?properties=email,hs_lead_status');
    assertThat(requestOptions.headers.Authorization).isEqualTo('Bearer test-token');
    assertThat(eventData.event_name).isEqualTo('hubspot_lead_status');
    assertThat(eventData.contactId).isEqualTo(123);
    assertThat(eventData.lead_status).isEqualTo('CONNECTED');
    assertThat(eventData.properties.email).isEqualTo('test@example.com');
- name: Does not run container when HubSpot API returns an error
  code: |-
    mock('getRequestPath', '/hubspot');
    mock('getRequestMethod', 'POST');
    mock('getRequestBody', '[{"objectId":123,"propertyValue":"NEW"}]');
    mock('sendHttpGet', (url, options) => {
      return {
        then: (onSuccess, onFailure) => {
          onSuccess({ statusCode: 401, body: '{"message":"Unauthorized"}' });
        }
      };
    });
    runCode(mockData);
    assertApi('setResponseStatus').wasCalledWith(200);
    assertApi('runContainer').wasNotCalled();
setup: |-
  const mockData = {
    path: '/hubspot',
    eventName: 'hubspot_lead_status',
    accessToken: 'test-token',
    contactProperties: [{ properties: 'email' }, { properties: 'hs_lead_status' }]
  };

  mock('claimRequest', () => {});
  mock('returnResponse', () => {});
  mock('logToConsole', () => {});


